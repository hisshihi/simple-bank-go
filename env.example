DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_PASS=password
DB_NAME=simple_bank

HTTP_ADDR=:8080

LOGGER_LEVEL=debug
LOGGER_PRETTY=true

# для goose (task migrate:up)
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://user:password@localhost:5432/simple_bank?sslmode=disable
GOOSE_MIGRATION_DIR=./migrations
